{
  "name": "marina-booking-platform",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @marina/database generate",
    "db:migrate": "pnpm --filter @marina/database migrate",
    "db:rls": "pnpm --filter @marina/database rls",
    "db:approle": "pnpm --filter @marina/database approle",
    "db:seed": "pnpm --filter @marina/database seed",
    "db:studio": "pnpm --filter @marina/database studio",
    "dev:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-local.ps1",
    "dev:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-local.ps1 -NoServers",
    "verify": "turbo run typecheck test build",
    "db:seed:season": "pnpm --filter @marina/database seed:season",
    "db:reset": "pnpm db:seed && pnpm db:seed:waiver && pnpm db:seed:season",
    "db:seed:waiver": "pnpm --filter @marina/database seed:waiver",
    "db:migrate:deploy": "pnpm --filter @marina/database migrate:deploy",
    "db:state": "pnpm --silent --filter @marina/database state",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.6.0",
    "@playwright/test": "^1.49.0"
  }
}

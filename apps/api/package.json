{
  "name": "@marina/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --include \"src/**\" --exclude \"../../.sandbox/**\" --exclude \"**/*.log\" src/index.ts",
    "build": "tsc --noEmit && node build.mjs",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clerk/backend": "^2.33.5",
    "@hono/node-server": "^1.13.0",
    "@marina/auth": "workspace:*",
    "@marina/core": "workspace:*",
    "@marina/database": "workspace:*",
    "@marina/emails": "workspace:*",
    "@marina/types": "workspace:*",
    "@paralleldrive/cuid2": "^2.2.2",
    "@prisma/client": "^6.19.3",
    "hono": "^4.6.0",
    "resend": "^4.0.0",
    "stripe": "^17.5.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "@types/react": "^18.3.30",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}

# ---------------------------------------------------------------------------
# PER-APP ENV for the customer web app (apps/web).
#
# WHY THIS FILE EXISTS: Next.js only reads .env files from the directory that
# holds next.config.mjs — i.e. apps/web/, NOT the repo root. When the whole
# stack is booted with turbo from the root (pnpm dev / dev-local.sh), turbo
# forwards the root .env via globalPassThroughEnv, so this is not needed. But
# when the web app is started STANDALONE (e.g. `next dev` in apps/web after a
# crash restart), the root .env is invisible and the web process loses
# NEXT_PUBLIC_DEMO_MODE. DEMO_MODE then fails OPEN (defaults ON), the portal
# silently serves fake fixtures (pontoon-boat, fishing-boat…), and every real
# LakeSonoma Book button — which links to /activities/pontoon-5-person — 404s.
#
# The generated apps/web/.env.local (copied from these values by
# scripts/setup-local.sh and re-synced by scripts/dev-local.sh) closes that gap
# so the standalone-start path behaves identically to the turbo path.
#
#   cp apps/web/.env.local.example apps/web/.env.local
#
# apps/web/.env.local is gitignored (it mirrors local DB creds). This template
# is committed. None of these values are secret.
# ---------------------------------------------------------------------------

# --- Database (local Postgres; server-side loaders in apps/web read these) ---
DATABASE_URL="postgresql://marina:marina@127.0.0.1:5432/marina"
DIRECT_URL="postgresql://marina:marina@127.0.0.1:5432/marina"
APP_DATABASE_URL="postgresql://app_user:appuserpass123@127.0.0.1:5432/marina"
APP_DB_PASSWORD="appuserpass123"

# --- Auth: Clerk OFF → dev shim ---
REQUIRE_CLERK_AUTH="false"

# --- THE CRITICAL ONE: real API, not the demo fixtures. Never omit this. ---
NEXT_PUBLIC_DEMO_MODE="0"

# --- Payments: simulate in dev (reserve mode: pay at the marina) ---
DEV_FAKE_PAYMENTS="true"
NEXT_PUBLIC_DEV_FAKE_PAYMENTS="true"
PAYMENT_MODE="reserve"
NEXT_PUBLIC_PAYMENT_MODE="reserve"

# --- App wiring: where the web app finds the Hono API + which tenant to serve ---
PORT="3001"
API_URL="http://localhost:3001"
API_BASE_URL="http://localhost:3001"
OPERATOR_SLUG="lake-sonoma"
APP_BASE_DOMAIN="localhost:3000"

# --- White-label brand (seed operator = Lake Sonoma Marina) ---
BRAND_NAME="Lake Sonoma Marina"
BRAND_COLOR="#0e7490"

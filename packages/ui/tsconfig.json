{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Consumed as TypeScript SOURCE (`main`/`exports` -> ./src/index.ts): the Next
    // apps compile it via transpilePackages + a `.js` -> `.ts` extensionAlias
    // (D-009). Nothing resolves a `dist/` here, so emitting one would leave a
    // stale, unreferenced copy that only makes the "which JS actually runs?"
    // question harder.
    "rootDir": "src",
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": ["dom", "dom.iterable", "es2022"]
  },
  "include": ["src"]
}
